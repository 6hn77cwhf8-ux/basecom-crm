{
  "name": "basecom-crm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @basecom/server dev",
    "dev:desktop": "pnpm --filter @basecom/desktop dev",
    "db:up": "docker compose up -d db"
  }
}
